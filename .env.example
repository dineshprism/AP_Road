# Docker / production environment
DB_PASSWORD=change-this-db-password
JWT_SECRET=<random-64-character-secret>
CORS_ORIGIN=https://your-domain.com
# Comma-separated Host headers allowed by the API (reject others with 400).
# Prefer nginx server_name default catch-all rejecting unknown hosts as well.
ALLOWED_HOSTS=rspt.prismappolice.in
# Browser Maps key (HTTP referrer–restricted). GOOGLE_MAPS_API_KEY is accepted as an alias.
GOOGLE_MAPS_BROWSER_KEY=your-domain-restricted-google-maps-browser-key
GOOGLE_MAPS_API_KEY=
MAX_UPLOAD_MB=5
GLOBAL_RATE_LIMIT_MAX=1000000
LOGIN_RATE_LIMIT_MAX=1000000
RAG_RATE_LIMIT_MAX=1000000
# Session: 30 min idle logout; JWT rotates every 30 min while active (no logout on refresh)
SESSION_IDLE_TIMEOUT_MS=1800000
TRUST_PROXY=true
# Signed-copy hardening: Ghostscript PDF CDR + ClamAV (required in production)
UPLOAD_SANITIZE_ENABLED=true
# ClamAV malware scanning (required in production; docker compose starts clamav by default)
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Optional: comma-separated IPs allowed for Prism full backup (empty = any IP)
PRISM_BACKUP_IP_ALLOWLIST=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=1200

# Local RAG with Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.2
RAG_TOP_K=5
