# Maps: use a browser-restricted key only (HTTP referrer limits in Google Cloud). Never expose server secrets.
GOOGLE_MAPS_BROWSER_KEY=
# Legacy server key used only if you proxy maps server-side (not returned to clients)
GOOGLE_MAPS_API_KEY=

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=1200

DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/road_accident_db
JWT_SECRET=<random-64-character-secret>
PORT=3000
CORS_ORIGIN=http://localhost:8081
# Comma-separated Host headers allowed by the API (reject others with 400).
# Prefer nginx server_name default catch-all rejecting unknown hosts as well.
ALLOWED_HOSTS=rspt.prismappolice.in

# Signed-copy upload cap in MB (default 5 — matches APTS requirement)
MAX_UPLOAD_MB=5

# Content sanitization: re-encode images, rewrite PDFs (Ghostscript in Docker image)
UPLOAD_SANITIZE_ENABLED=true
# Optional ClamAV (docker compose --profile clamav up -d)
CLAMAV_ENABLED=false

NODE_ENV=production
