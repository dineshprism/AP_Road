# Example nginx site for rspt.prismappolice.in
# Copy to /etc/nginx/sites-available/roadsafety and symlink to sites-enabled.
#
# Also add to /etc/nginx/nginx.conf inside http { }:
#   server_tokens off;
#
# Use BOTH this nginx catch-all AND the app ALLOWED_HOSTS allowlist.

# Reject unknown Host headers at the edge (returns connection closed).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name rspt.prismappolice.in;

    # Match app signed-copy limit (MAX_UPLOAD_MB default 5)
    client_max_body_size 5M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# After certbot SSL, duplicate client_max_body_size and proxy headers in the 443 server block.
# Add a default_server SSL catch-all that returns 444 for unrecognized hosts.
